# Local Terraform directories
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
.terraform.tfstate
.terraform.tfstate.backup

# Crash logs
crash.log

# Ignore override files as they are usually local
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore variable files containing sensitive data
*.tfvars
*.tfvars.json
terraform.tfvars
terraform.tfvars.json

# Ignore plan output files
*.plan

# Ignore backup files
*.backup
.terraform